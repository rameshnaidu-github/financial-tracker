{
  "name": "local-finance-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm:server:dev\" \"pnpm:client:dev\"",
    "server:dev": "node --no-warnings --watch server/index.ts",
    "client:dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --no-warnings server/index.ts",
    "app:start": "bash scripts/start.sh",
    "app:stop": "bash scripts/stop.sh",
    "test:qa": "node --no-warnings tests/qa-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.10.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
